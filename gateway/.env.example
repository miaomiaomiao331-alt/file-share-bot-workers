# ===== Discord 基础配置 =====
# Bot Token（Discord Developer Portal → Bot → Reset Token）
DISCORD_TOKEN=

# ===== 自动导入系统 =====
# 上传频道 ID：用户往这里发 PNG/JSON，bot 自动解析并发帖
IMPORT_CHANNEL_ID=

# 角色卡发布论坛 ID（必填，也是世界书/预设未单独配置时的回退频道）
CHARACTER_FORUM_ID=

# 世界书发布论坛 ID（可选，不填则发到 CHARACTER_FORUM_ID）
WORLDBOOK_FORUM_ID=

# 预设发布论坛 ID（可选，不填则发到 CHARACTER_FORUM_ID）
PRESET_FORUM_ID=

# 文本文档发布论坛 ID（可选，不填则发到 CHARACTER_FORUM_ID）
TXT_FORUM_ID=

# ===== 异地备份（可选）=====
# 自建 CloudFlare-ImgBed 地址，配置后导入的文件会自动备份一份
IMGBED_URL=
# ImgBed 上传鉴权码（未开启鉴权可留空）
IMGBED_AUTH_CODE=

# ===== 存储后端 =====
SUPABASE_URL=
SUPABASE_KEY=

# ===== 其他 =====
# 本地 Asset 缓存文件数上限
ASSET_CACHE_LIMIT=100
